model User {
  id             String          @id @default(uuid())
  tenantId       String?         @map("tenant_id")
  email          String          @unique @db.VarChar(255)
  passwordHash   String          @map("password_hash") @db.VarChar(255)
  name           String          @db.VarChar(255)
  avatarUrl      String?         @map("avatar_url")
  globalRole     GlobalRole      @default(TENANT_USER) @map("global_role")
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  staffProfile   StaffProfile?
  supportTickets SupportTicket[]
  shifts         CashierShift[]
  tenant         Tenant?         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("users")
}

model StaffProfile {
  id                 String          @id @default(uuid())
  userId             String          @unique @map("user_id")
  branchId           String?         @map("branch_id")
  designation        Designation     @default(GENERAL_STAFF)
  permissionOrders   PermissionLevel @default(MANAGE) @map("permission_orders")
  permissionMenu     PermissionLevel @default(READ) @map("permission_menu")
  permissionReports  PermissionLevel @default(NONE) @map("permission_reports")
  permissionSettings PermissionLevel @default(NONE) @map("permission_settings")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")
  branch             Branch?         @relation(fields: [branchId], references: [id])
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([branchId])
  @@index([userId])
  @@map("staff_profiles")
}

enum GlobalRole {
  SUPER_ADMIN
  TENANT_USER
}

enum Designation {
  OWNER
  BRANCH_MANAGER
  CASHIER
  KITCHEN_STAFF
  RIDER
  GENERAL_STAFF
}

enum PermissionLevel {
  NONE
  READ
  MANAGE
}

model CashierShift {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  branchId    String?   @map("branch_id")
  userId      String    @map("user_id")
  startTime   DateTime  @default(now()) @map("start_time")
  endTime     DateTime? @map("end_time")
  status      String    @default("OPEN") @db.VarChar(50)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch      Branch?   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([branchId])
  @@index([userId])
  @@map("cashier_shifts")
}
