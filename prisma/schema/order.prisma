model Order {
  id                   String          @id @default(uuid())
  orderNumber          String          @unique @map("order_number") @db.VarChar(50)
  tenantId             String          @map("tenant_id")
  branchId             String          @map("branch_id")
  customerId           String?         @map("customer_id")
  channel              OrderChannel
  fulfillmentType      FulfillmentType @map("fulfillment_type")
  status               OrderStatus     @default(PENDING)
  paymentMethod        PaymentMethod   @map("payment_method")
  paymentStatus        PaymentStatus   @default(UNPAID) @map("payment_status")
  subtotal             Decimal         @db.Decimal(10, 2)
  taxAmount            Decimal         @default(0) @map("tax_amount") @db.Decimal(10, 2)
  discountAmount       Decimal         @default(0) @map("discount_amount") @db.Decimal(10, 2)
  deliveryFee          Decimal         @default(0) @map("delivery_fee") @db.Decimal(10, 2)
  grandTotal           Decimal         @map("grand_total") @db.Decimal(10, 2)
  deliveryAddress      String?         @map("delivery_address")
  nearestLandmark      String?         @map("nearest_landmark")
  deliveryInstructions String?         @map("delivery_instructions")
  tableNumber          String?         @map("table_number") @db.VarChar(20)
  specialInstructions  String?         @map("special_instructions")
  privateKitchenNotes  String?         @map("private_kitchen_notes")
  statusTimeline       Json?           @map("status_timeline")
  areaId               String?         @map("area_id")
  createdById          String?         @map("created_by_id")
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")
  items                OrderItem[]
  branch               Branch          @relation(fields: [branchId], references: [id])
  customer             Customer?       @relation(fields: [customerId], references: [id])
  tenant               Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  area                 Area?           @relation(fields: [areaId], references: [id])
  createdBy            User?           @relation("OrderCreatedBy", fields: [createdById], references: [id])

  @@index([tenantId, branchId, status])
  @@index([customerId, createdAt])
  @@index([createdById])
  @@map("orders")
}

model OrderItem {
  id               String    @id @default(uuid())
  orderId          String    @map("order_id")
  menuItemId       String?   @map("menu_item_id")
  itemName         String    @map("item_name") @db.VarChar(255)
  unitPrice        Decimal   @map("unit_price") @db.Decimal(10, 2)
  quantity         Int
  selectedVariants Json?     @map("selected_variants")
  itemNote         String?   @map("item_note")
  totalPrice       Decimal   @map("total_price") @db.Decimal(10, 2)
  createdAt        DateTime  @default(now()) @map("created_at")
  menuItem         MenuItem? @relation(fields: [menuItemId], references: [id])
  order            Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_items")
}

enum OrderChannel {
  POS
  WEBSITE
  KITCHEN_MANUAL
  THIRD_PARTY
}

enum FulfillmentType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum OrderStatus {
  PENDING
  ACCEPTED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  COD
  CARD
  ONLINE
  WALLET
  BANK_TRANSFER
  LOYALTY_POINTS
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}
