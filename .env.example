# Database
DATABASE_URL="postgresql://user:password@localhost:5432/indolj_db?schema=public"

# Server
PORT=4000
NODE_ENV=development

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Redis
REDIS_URL="redis://localhost:6379"

# Email (SMTP — e.g., Amazon SES, Resend, Postmark)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="your-smtp-user"
SMTP_PASS="your-smtp-password"
SMTP_FROM="noreply@indolj.com"

# Cloudinary 
CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_API_SECRET_KEY=
CLOUDINARY_SOLEBAZAAR_UPLOAD_PRESET=

# Cors
CORS_ORIGIN="http://localhost:5173,http://localhost:3000"
